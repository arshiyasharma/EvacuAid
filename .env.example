# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: GEMINI_TRIAGE_MODEL=gemini-3.5-flash-lite  GEMINI_TRIAGE_THINKING=minimal

# Capital One Nessie v2 (https://v2.nessieisreal.com/account)
NESSIE_API=

# Maps (https://cloud.maptiler.com) and fire data (https://firms.modaps.eosdis.nasa.gov/api/map_key)
NEXT_PUBLIC_MAPTILER_KEY=
FIRMS_MAP_KEY=

# Tiger Data (Postgres connection string)
TIGER_DATABASE_URL=


# Solana devnet
SOLANA_CLUSTER=devnet
SOLANA_KEYPAIR_PATH=
SOLANA_PUBLIC_KEY=

# Vultr server
VULTR_SERVER_IP=

# Photon (iMessage)
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_AGENT_HANDLE=

# Operator login: run `bun scripts/set-admin.ts` to fill these
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
